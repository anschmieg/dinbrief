{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dinbrief.dev/schema/v2/letter.schema.json",
  "title": "dinbrief letter",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "recipient", "date", "salutation", "closing"],
  "properties": {
    "format": {"const": "dinbrief/v2", "description": "Version of the dinbrief source format."},
    "language": {"type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$", "default": "de-DE", "examples": ["de-DE", "en-GB", "en-US"], "description": "BCP-47 language tag used for typography and generated labels."},
    "sender": {"description": "Configured sender profile ID or an inline sender.", "oneOf": [{"type": "string"}, {"$ref": "#/$defs/party"}]},
    "recipient": {"description": "Postal recipient and address.", "$ref": "#/$defs/party"},
    "date": {"type": "string", "format": "date", "description": "ISO date (YYYY-MM-DD); localized only when rendered."},
    "location": {"type": "string", "description": "Place shown before the localized date; defaults to the sender city."},
    "salutation": {"type": "string", "minLength": 1, "description": "Explicit salutation including punctuation."},
    "closing": {"type": "string", "minLength": 1, "description": "Explicit closing phrase including punctuation."},
    "references": {"type": "object", "additionalProperties": {"type": "string"}},
    "delivery": {"type": "object", "additionalProperties": false, "properties": {"method": {"enum": ["print", "email", "both"]}}},
    "layout": {"$ref": "#/$defs/layout"},
    "tags": {"type": "array", "description": "Searchable archive tags; they never affect layout.", "items": {"type": "string"}, "uniqueItems": true},
    "attachments": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "address": {
      "type": "object", "required": ["street", "postal_code", "city"],
      "additionalProperties": false,
      "properties": {
        "street": {"type": "string", "description": "Street and house number."}, "postal_code": {"type": "string"},
        "city": {"type": "string"}, "region": {"type": "string", "description": "State, province, or region where required by the postal format."},
        "country": {"type": "string", "pattern": "^[A-Z]{2}$", "default": "DE"},
        "extra": {"type": "array", "items": {"type": "string"}}
      }
    },
    "party": {
      "type": "object", "required": ["address"],
      "additionalProperties": false,
      "anyOf": [
        {"required": ["name"]},
        {"required": ["organization"]}
      ],
      "properties": {
        "name": {"type": "string", "description": "Person or primary addressee."}, "organization": {"type": "string"},
        "department": {"type": "string"}, "address": {"$ref": "#/$defs/address"},
        "phone": {"type": "string"}, "email": {"type": "string", "format": "email"},
        "website": {"type": "string", "format": "uri"}
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "standard": {"const": "din-5008"}, "form": {"enum": ["A", "B"]},
        "window_envelope": {"type": "boolean"}, "fold_marks": {"type": "boolean"},
        "hole_mark": {"type": "boolean"}
      }
    }
  }
}
