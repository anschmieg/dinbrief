{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DIN-Brief: Prüfen",
      "type": "process",
      "command": "dinbrief",
      "args": ["check", "${file}"]
    },
    {
      "label": "DIN-Brief: PDF erstellen",
      "type": "process",
      "command": "dinbrief",
      "args": ["render", "${file}"]
    },
    {
      "label": "DIN-Brief: PDF erstellen und öffnen",
      "type": "process",
      "command": "dinbrief",
      "args": ["open", "${file}"],
      "group": {"kind": "build", "isDefault": true}
    },
    {
      "label": "DIN-Brief: Live-Vorschau",
      "type": "process",
      "command": "dinbrief",
      "args": ["watch", "${file}"],
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
